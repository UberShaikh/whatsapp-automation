APP_ENV=development
DATABASE_URL=postgresql://grocery_user:replace_me@localhost:5432/grocery_dev

# Local demo transport. Replace the two secret placeholders before use.
WHATSAPP_MODE=fake
WHATSAPP_APP_SECRET=replace_with_a_long_random_secret
WHATSAPP_VERIFY_TOKEN=replace_with_a_separate_random_token
WHATSAPP_BUSINESS_ACCOUNT_ID=local-demo-account
WHATSAPP_PHONE_NUMBER_ID=local-demo-number

# Required when WHATSAPP_MODE=meta. Use Meta's actual IDs and supported API version.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=
# Exact inbound provider IDs (phone digits or BSUID); comma-separated test recipients only.
WHATSAPP_TEST_RECIPIENTS=
PUBLIC_BASE_URL=

STORE_NAME=Grocery Store Demo
SUPPORT_CONTACT=Contact the store operator
AUTOMATION_PAUSED=false
HOST=127.0.0.1
PORT=3000

# Merchant accounts and inventory. Use the SAME Supabase project as DATABASE_URL.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
MERCHANT_API_PORT=3001
MERCHANT_API_URL=http://127.0.0.1:3001
MERCHANT_WEB_URL=http://127.0.0.1:3100
